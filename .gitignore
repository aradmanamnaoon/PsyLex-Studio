Thumbs.db
Desktop.ini

# Never publish third-party books, or derived/private lexicon exports.
/resources/dictionaries/
/resources/lexicon.jsonl
/resources/*source*.docx
/resources/*private*.docx
/legacy_dictionary_exports/

# Common pasted support logs and potentially sensitive screenshots
/Pasted text*.txt
/Screenshot *.png
/screenshots/

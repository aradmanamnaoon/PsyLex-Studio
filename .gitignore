# PsyLex Studio — public-repository safety defaults
# Only original starter glossary, code, icons, and safe test fixtures
# remain trackable. Proprietary dictionaries and their exports are blocked.

# Python environments, interpreters, bytecode and tool caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.ipynb_checkpoints/
.pyre/

# Generated distributions / installers / Windows binary artifacts
/build/
/dist/
/output/
/releases/
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.dll
*.pyd
*.pdb
*.spec
*.whl
*.egg
*.egg-info/
*.pyz
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.nupkg


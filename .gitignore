.env
.env.*
!.env.example
!.env.template
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.key
*.asc
id_rsa*
id_ed25519*
*credentials*.json
*secrets*.json
*token*.json
*api_key*.txt
*api_keys*.txt
*_private*.json

